# ==============================================================================
# DreamFolio SaaS CV Platform - Environment Configuration (.env)
# ==============================================================================

# AI Engine (Google Gemini API)
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Security / Authentication
# Generate a strong secret key for signing JWT tokens and portfolio hashes
JWT_SECRET=cv_saas_production_super_secret_jwt_key_2026

# MySQL Database Configuration
# Works seamlessly with cPanel MySQL or local MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# Optional: Full Database URL (overrides individual MySQL settings if provided)
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/db_name

# Optional: Allowed CORS Origins (comma-separated, e.g. https://s.tourglobalhub.com)
ALLOWED_ORIGINS=
