# ==============================================================================
# DreamFolio SaaS CV Platform - Environment Configuration (.env)
# ==============================================================================

# AI Engine (Google Gemini API)
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Multi-Key Failover Pool (comma-separated for 100% uptime & quota failover)
GEMINI_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...

# Optional: Autonomous Google Cloud Key Minting (Auto-generates fresh key if keys expire)
# Requires a GCP Service Account with 'roles/serviceusage.apiKeysAdmin'
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Security / Authentication
# Generate a strong secret key for signing JWT tokens and portfolio hashes
JWT_SECRET=cv_saas_production_super_secret_jwt_key_2026

# MySQL Database Configuration
# Works seamlessly with cPanel MySQL or local MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# Optional: Full Database URL (overrides individual MySQL settings if provided)
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/db_name

# Optional: Allowed CORS Origins (comma-separated, e.g. https://s.tourglobalhub.com)
ALLOWED_ORIGINS=

# Cloudflare for SaaS (Zero-Touch Automated SSL for Custom User Domains)
# Get from Cloudflare Dashboard: dreemfolio.com -> Overview (Zone ID) & My Profile -> API Tokens  
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FALLBACK_ORIGIN=cname.dreemfolio.com

# ==============================================================================
# Dual-Provider SMTP Email Configuration (Zero-Downtime Automatic Failover)
# ==============================================================================
# Primary SMTP Provider (e.g. Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_SySchtUu_your_resend_api_key
SMTP_FROM_EMAIL=no-reply@dreemfolio.com
SMTP_FROM_NAME="DreemFolio AI"
SMTP_USE_SSL=true

# Backup / Fallback SMTP Provider (e.g. Gmail - 100% Uptime Failover)
# If Primary encounters errors (suspension, quota limits), dispatcher automatically falls over to Backup.
FALLBACK_SMTP_HOST=smtp.gmail.com
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_USER=your_gmail_address@gmail.com
FALLBACK_SMTP_PASSWORD=your_gmail_app_password
FALLBACK_SMTP_FROM_EMAIL=your_gmail_address@gmail.com
FALLBACK_SMTP_FROM_NAME="DreemFolio AI"
FALLBACK_SMTP_USE_SSL=false

ADMIN_NOTIFICATION_EMAIL=admin@dreemfolio.com


