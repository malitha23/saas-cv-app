[Unit]
Description=DreemFolio AI Automated Nginx SSL Daemon
After=network.target nginx.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/dreemfolio/htdocs/www.dreemfolio.com
ExecStart=/usr/bin/python3 /home/dreemfolio/htdocs/www.dreemfolio.com/scripts/nginx_auto_ssl.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
